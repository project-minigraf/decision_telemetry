<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.adityamukho</groupId>
    <artifactId>decision-telemetry-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>trail-demo</artifactId>
  <name>trail-demo</name>
  <description>A checkout with a planted race, used to show a run diff.</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.adityamukho</groupId>
      <artifactId>trail-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.adityamukho</groupId>
      <artifactId>minigraf-jvm</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- This block is all a project needs to turn the plugin on. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.adityamukho</groupId>
              <artifactId>trail-javac</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs combine.children="append">
            <arg>-Xplugin:DecisionTelemetry</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.adityamukho.trail.demo.DemoMain</mainClass>
          <arguments>
            <argument>${project.build.directory}/decision-telemetry-demo</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
